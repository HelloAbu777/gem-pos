# Files to ignore during Vercel deployment

# Dependencies
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files (will be set in Vercel dashboard)
.env
.env.local
.env*.local

# Development files
.vscode
.idea
*.swp
*.swo
*~

# Testing
coverage
.nyc_output

# Build artifacts (Vercel builds fresh)
.next
out
build
dist

# Prisma generated files (regenerated during build)
# Keep schema.prisma and migrations

# Documentation (optional, can deploy if needed)
*.md
!README.md

# Scripts
*.sh
*.bat
deploy.ps1

# Git
.git
.gitignore

# OS files
.DS_Store
Thumbs.db
