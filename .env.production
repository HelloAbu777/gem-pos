# Production Environment Variables
# NOTE: Set these in Vercel Dashboard → Settings → Environment Variables

# Database URL (Vercel Postgres, Neon, or other PostgreSQL provider)
DATABASE_URL="your-production-database-url"

# Auth Secret (Generate new: openssl rand -base64 32)
NEXTAUTH_SECRET="your-production-secret-key"

# Production URL (automatically set by Vercel)
NEXTAUTH_URL="https://your-domain.vercel.app"
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"
