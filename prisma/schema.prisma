// Prisma Schema for GEM POS System
// Database: SQLite (local dev)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

// Foydalanuvchilar (Super Admin, Admin va Kassir)
model User {
  id        String   @id @default(cuid())
  name      String
  login     String   @unique
  password  String   // bcrypt hash
  role      String   @default("CASHIER") // SUPER_ADMIN | ADMIN | CASHIER
  branchId  String?  // SUPER_ADMIN uchun null bo'lishi mumkin
  branch    Branch?  @relation(fields: [branchId], references: [id])
  sales     Sale[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// Filiallar (Do'konlar)
model Branch {
  id        String     @id @default(cuid())
  name      String
  address   String?
  users     User[]
  products  Product[]
  sales     Sale[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("branches")
}

// Kategoriyalar
model Category {
  id        String    @id @default(cuid())
  name      String
  branchId  String    @default("default-branch")
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([name, branchId])
  @@map("categories")
}

// Taminotchilar (Distribyutorlar)
model Supplier {
  id            String    @id @default(cuid())
  name          String
  contactPerson String
  phone         String
  branchId      String    @default("default-branch")
  products      Product[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("suppliers")
}

// Mahsulotlar
model Product {
  id             String      @id @default(cuid())
  name           String
  barcode        String?     @unique
  unit           String      @default("dona")
  quantity       Float       @default(0)
  minQuantity    Float       @default(10)
  purchasePrice  Float
  salePrice      Float
  margin         Float
  vatType        String      @default("NO_VAT")
  expiryDate     DateTime?
  isPinned       Boolean     @default(false)
  categoryId     String
  category       Category    @relation(fields: [categoryId], references: [id])
  supplierId     String
  supplier       Supplier    @relation(fields: [supplierId], references: [id])
  branchId       String
  branch         Branch      @relation(fields: [branchId], references: [id])
  saleItems      SaleItem[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([branchId])
  @@index([branchId, isPinned])
  @@index([barcode])
  @@map("products")
}

// Sotuvlar
model Sale {
  id              String        @id @default(cuid())
  totalAmount     Float
  paymentType     String
  cashAmount      Float?
  cardAmount      Float?
  saleType        String        @default("RETAIL")
  cashierId       String
  cashier         User          @relation(fields: [cashierId], references: [id])
  branchId        String
  branch          Branch        @relation(fields: [branchId], references: [id])
  legalEntityId   String?
  legalEntity     LegalEntity?  @relation(fields: [legalEntityId], references: [id])
  saleItems       SaleItem[]
  createdAt       DateTime      @default(now())

  @@index([branchId])
  @@index([branchId, createdAt(sort: Desc)])
  @@index([legalEntityId])
  @@map("sales")
}

// Sotuv tafsilotlari
model SaleItem {
  id          String   @id @default(cuid())
  saleId      String
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  itemName    String
  quantity    Float
  priceAtSale Float

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

// Yuridik Shaxslar
model LegalEntity {
  id        String   @id @default(cuid())
  name      String
  phone     String
  branchId  String   @default("default-branch")
  sales     Sale[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("legal_entities")
}

// Taomlar (Ovqatlar)
model Dish {
  id        String   @id @default(cuid())
  name      String
  price     Float
  costPrice Float    @default(0) // Tan narxi (tayyorlash xarajati)
  barcode   String?  @unique
  isActive  Boolean  @default(true)
  branchId  String   @default("default-branch")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("dishes")
}

// Ombor (Warehouse) — kassada ko'rinmaydi
model WarehouseItem {
  id            String    @id @default(cuid())
  name          String
  barcode       String?   @unique
  unit          String    @default("dona")
  quantity      Float     @default(0)
  minQuantity   Float     @default(10)
  purchasePrice Float     @default(0)
  salePrice     Float     @default(0)
  vatType       String    @default("NO_VAT")
  expiryDate    DateTime?
  description   String?
  categoryId    String?
  supplierId    String?
  branchId      String    @default("default-branch")
  transferredAt DateTime?
  isTransferred Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("warehouse_items")
}
